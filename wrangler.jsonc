{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mtype",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [{ "pattern": "mtype.tahmid.dev", "custom_domain": true }]
}
